# Copy to .env.local and fill in from your Supabase project (Settings -> API).
# The anon key is public-by-design; row-level security is what protects your data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the app fetches the live catalog from (defaults match the real repo).
VITE_GH_OWNER=Favour-Okoye
VITE_GH_REPO=money-tree-tracker
